---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import Card from '@/components/Card.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Label from '@/components/home/Label.astro'
import { siteConfig } from '@/site-config'
import GithubCard from '@/components/GithubCard.astro'

import avatar from '@/assets/avatar.png'

const linkClass =
  'text-foreground underline decoration-muted-foreground/40 underline-offset-4 hover:text-primary hover:decoration-primary'

const publications = [
  {
    authors: ['Tengjiao Yin', 'Jinglei Shi', 'Heng Guo', 'Xi Wang'],
    title: 'VIGOR: VIdeo Geometry-Oriented Reward for Temporal Generative Alignment',
    venue: 'ECCV',
    year: 2026,
    arxiv: '2603.16271',
    project: 'https://vigor-geometry-reward.com/',
    links: {
      paper: 'https://doi.org/10.1007/978-3-032-37189-8_14',
      arxiv: 'https://arxiv.org/abs/2603.16271',
      code: 'https://github.com/Ethan2k04/VIGOR',
      poster: 'https://eccv.ecva.net/virtual/2026/poster/3197'
    }
  }
]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB966'>
  <div class='-mt-6 flex w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
    <section class='animate flex flex-col items-center gap-y-5'>
      <Image
        src={avatar}
        alt='profile'
        class='h-24 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-3'>
        <h1 class='text-3xl font-bold'>{siteConfig.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Singapore'>
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-location-line'></use>
            </svg>
          </Label>
          <Label
            title='Github'
            as='a'
            href='https://github.com/Ethan2k04'
            target='_blank'
          >
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-github-line'></use>
            </svg>
          </Label>
          <Label
            title='LinkedIn'
            as='a'
            href='https://www.linkedin.com/in/tengjiao-yin-70bb9a344/'
            target='_blank'
          >
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-linkedin-line'></use>
            </svg>
          </Label>
          <Label
            title='Google Scholar'
            as='a'
            href='https://scholar.google.fr/citations?user=fW1BZeoAAAAJ&hl=en'
            target='_blank'
          >
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#google-scholar-line'></use>
            </svg>
          </Label>
          <Label
            title='Email'
            as='a'
            href='mailto:yintengjiao2004@gmail.com'
            target='_blank'
          >
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-mail-line'></use>
            </svg>
          </Label>
        </div>
      </div>
    </section>

    <link
      href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,700&family=Ma+Shan+Zheng&display=swap'
      rel='stylesheet'
    />
    <Section title='About'>
      <p class='text-muted-foreground'>
        Master's Student | MMLab@NTU |
        <a class={linkClass} href='/CV_English.pdf' target='_blank'>CV</a>
      </p>
      <p class='text-muted-foreground'>
        I'm currently a Master's student at
        <a class={linkClass} href='https://www.mmlab-ntu.com/' target='_blank'>MMLab@NTU</a>,
        Nanyang Technological University, advised by
        <a class={linkClass} href='https://liuziwei7.github.io/' target='_blank'>Prof. Ziwei Liu</a>.
        Before that, I was fortunate to work with
        <a class={linkClass} href='https://jingleishi.github.io/' target='_blank'>Prof. Jinglei Shi</a>
        and
        <a class={linkClass} href='https://triocrossing.github.io/' target='_blank'>Prof. Xi Wang</a>,
        and I also interned at Microsoft. My research interests lie in Image/Video Generation, 3D
        Vision, AI Agents, and Finance.
      </p>
      <div class='motto rounded-2xl border border-border bg-primary-foreground px-5 py-3'>
        <p>
          <span class='motto-lead text-foreground'>Poetically man dwells</span>
          <span class='text-muted-foreground'>
            on this <span class='motto-script text-primary'>earth</span>.
          </span>
        </p>
        <p class='flex flex-wrap items-baseline gap-x-4'>
          <span class='motto-zh text-muted-foreground'>人，诗意地栖居</span>
          <span class='ms-auto text-sm text-muted-foreground'>&mdash; Martin Heidegger</span>
        </p>
      </div>
    </Section>

    <Section title='Publications'>
      <ul class='ms-4 flex list-disc flex-col gap-y-4'>
        {
          publications.map((pub) => (
            <li>
              <p class='text-muted-foreground'>
                {pub.authors.map((name, i) => (
                  <>
                    {i > 0 && ', '}
                    {name === siteConfig.author ? (
                      <span class='text-foreground underline underline-offset-4'>{name}</span>
                    ) : (
                      name
                    )}
                    {i === pub.authors.length - 1 && '.'}
                  </>
                ))}
              </p>
              <p>
                <a class='font-semibold' href={pub.project} target='_blank'>{pub.title}</a>,{' '}
                <span class='text-muted-foreground'>
                  <i>{pub.venue}</i> ({pub.year}). <i>arxiv</i>: {pub.arxiv}
                </span>
                {Object.entries(pub.links).map(([label, url]) => (
                  <>
                    {' '}
                    <a class='text-primary hover:underline' href={url} target='_blank'>[{label}]</a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title='Education'>
      <Card
        as='a'
        heading='M.S. in Artificial Intelligence'
        subheading='Nanyang Technological University'
        date='Aug 2026 – Jan 2028'
        href='https://www.ntu.edu.sg/'
        class='ntu-card'
        style={{
          backgroundPosition: 'right -20px center',
          backgroundRepeat: 'no-repeat',
          backgroundSize: '280px'
        }}
      >
        <ul class='ms-4 list-disc text-muted-foreground'></ul>
      </Card>
      <Card
        as='a'
        heading='B.S. in Computer Science'
        subheading='Nankai University'
        date='Sept 2022 – July 2026'
        href='https://en.nankai.edu.cn/'
        style={{
          backgroundImage: 'url(images/NKU_logo.svg)',
          backgroundPosition: 'right',
          backgroundRepeat: 'no-repeat',
          backgroundSize: '240px'
        }}
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <!-- <li>
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Dolore debitis recusandae, ut
            molestiae laboriosam pariatur!
          </li>
          <li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Molestiae, pariatur!</li> -->
        </ul>
      </Card>
    </Section>

    <Section title='Experience'>
      <Card
        as='a'
        heading='Applied Scientist Intern'
        subheading='Microsoft STCA'
        date='April 2026 - July 2026'
        href='https://www.microsoft.com/en-us/aprd/aboutus/team-stca'
        style={{
          backgroundImage: 'url(images/Microsoft_logo.svg)',
          backgroundPosition: 'right 20px center',
          backgroundRepeat: 'no-repeat',
          backgroundSize: '200px'
        }}
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <li>AI Agent Testing & Development.</li>
        </ul>
      </Card>
      <Card
        as='a'
        heading='Research Intern'
        subheading='Nankai Computer Vision Lab'
        date='April 2025 - Now'
        href='https://cv.nankai.edu.cn/'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
        class='cvlab-card'
        style={{
          backgroundPosition: 'right 20px center',
          backgroundRepeat: 'no-repeat',
          backgroundSize: '120px'
        }}
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <li>Image/Video Diffusion Models and 3D Vision.</li>
        </ul>
      </Card>
      <Card
        as='a'
        heading='Summer Intern'
        subheading='Mitacs Global Research Internship'
        date='August 2025 - November 2025'
        href='https://www.mitacs.ca/'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
        style={{
          backgroundImage: 'url(images/Mitacs_logo_blue.png)',
          backgroundPosition: 'right 20px center',
          backgroundRepeat: 'no-repeat',
          backgroundSize: '160px'
        }}
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <li>Coded Distributed Computing (MapReduce).</li>
        </ul>
      </Card>
    </Section>

    <!-- <Section title='Website List'>
      <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
        <ProjectCard
          href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
          heading='Lorem ipsum'
          subheading='dolor sit amet, oratio ornatus explicari pro ex'
          imagePath='/src/assets/projects/alex-tyson-2BAXJ7ha74s-unsplash.jpg'
        />
        <ProjectCard
          href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
          heading='Lorem ipsum'
          subheading='dolor sit amet, oratio ornatus explicari pro ex'
          imagePath='/src/assets/projects/angelica-teran-Bk9hpaXHK4o-unsplash.jpg'
        />
        <ProjectCard
          href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
          heading='Lorem ipsum'
          subheading='dolor sit amet, oratio ornatus explicari pro ex'
          imagePath='/src/assets/projects/kseniia-zapiatkina-yATU3rg8tNI-unsplash.jpg'
        />
        <ProjectCard
          href='/projects'
          heading='More projects'
          subheading='Check out more projects'
          imagePath='/src/assets/projects/wen-qiao-g_w8I64FiO0-unsplash.jpg'
        />
      </div>
    </Section> -->
  </div>

  <style>
    .motto {
      font-family: Georgia, 'Times New Roman', serif;
      line-height: 1.7;
    }
    .motto-lead {
      font-size: 1.2em;
      font-style: italic;
      font-weight: 600;
    }
    .motto-script {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.5em;
      font-style: italic;
      font-weight: 700;
      line-height: 1;
    }
    .motto-zh {
      font-family: 'Ma Shan Zheng', STKaiti, KaiTi, serif;
      font-size: 1.3em;
      letter-spacing: 0.12em;
      line-height: 1.4;
      white-space: nowrap;
    }
    :global(html:not(.dark) .cvlab-card) {
      background-image: url('/images/nankai_cvlab_logo_day.png');
    }
    :global(html.dark .cvlab-card) {
      background-image: url('/images/nankai_cvlab_logo_night.png');
    }
    :global(html:not(.dark) .ntu-card) {
      background-image: url('/images/NTU_logo_day.svg');
    }
    :global(html.dark .ntu-card) {
      background-image: url('/images/NTU_logo_night.svg');
    }
  </style>
</PageLayout>